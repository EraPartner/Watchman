{
  "name": "watchman",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:both": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev:both",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "backend:install": "cd backend && npm install",
    "backend:start": "cd backend && npm start",
    "setup": "npm install && npm run backend:install",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "optimize:images": "npx @squoosh/cli --webp auto src/**/*.{jpg,jpeg,png}",
    "preload-critical": "node scripts/generate-preload.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run lint && npm run format:check && npm run check:types",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "check:router": "node hardware/check-router.js"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "ping": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.0",
    "undici": "^5.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.17",
    "terser": "^5.44.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^1.0.0"
  }
}
