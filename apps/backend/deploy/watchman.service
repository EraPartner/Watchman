[Unit]
Description=Watchman backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/watchman/apps/backend
# Absolute path to Node installed via nvm. Update vX.Y.Z to match `which node`.
# Alternative: ExecStart=/bin/bash -lc 'exec node dist/index.js' to pick up nvm
# via a login shell (adds a shell layer; avoids hard-coding the Node version).
ExecStart=/home/pi/.nvm/versions/node/v22.11.0/bin/node dist/index.js
Environment=NODE_ENV=production
Environment=BACKEND_V2_HOST=0.0.0.0
Environment=BACKEND_V2_PORT=3001
Environment=DATA_DIR=/home/pi/.watchman/data
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
