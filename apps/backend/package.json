{
  "name": "@watchman/backend",
  "version": "2.0.0",
  "description": "Backend API for Watchman dashboard",
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "health-check": "curl -f http://localhost:3001/meta/health || exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,js,json}'",
    "format:check": "prettier --check '**/*.{ts,js,json}'",
    "security:check": "npm audit --audit-level moderate && npm run security:secrets",
    "security:fix": "npm audit fix",
    "security:secrets": "echo 'Checking for exposed secrets...' && ! grep -r -E '(password|secret|token|key)\\s*[:=]\\s*['\"]?[A-Za-z0-9]{20,}' --exclude-dir=node_modules --exclude-dir=dist --exclude=package*.json --exclude='*.md' --exclude='*.map' . || (echo '⚠️  Possible secrets found!' && exit 1)",
    "precommit": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.0-r.2",
    "@fastify/compress": "^7.0.3",
    "@fastify/websocket": "^10.0.1",
    "@roonlabs/node-roon-api": "^1.2.3",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.29.1",
    "fastify-plugin": "^4.5.1",
    "lru-cache": "^10.4.3",
    "net-snmp": "^3.26.1",
    "node-roon-api-transport": "github:RoonLabs/node-roon-api-transport",
    "pigpio-client": "^1.5.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socks-proxy-agent": "^8.0.5",
    "ssh2": "^1.17.0",
    "undici": "^8.1.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.6",
    "@types/node": "^25.7.0",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
