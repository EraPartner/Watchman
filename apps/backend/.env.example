# Core server
NODE_ENV=development
BACKEND_V2_PORT=3001
BACKEND_V2_HOST=0.0.0.0
LOG_LEVEL=info

# Data directory for DuckDB (config store)
DATA_DIR=./data

# Master key for AES-256-GCM encryption of service secrets at rest.
# Accepts base64 or hex 32-byte keys, or any string (hashed to 32 bytes).
# Optional. If empty, a random key is generated once in $DATA_DIR/master.key.
# Back up whichever key you use: if lost, stored service secrets are unrecoverable.
#   Generate: `openssl rand -base64 32`
WATCHMAN_MASTER_KEY=

# Legacy: WATCHMAN_SERVICES_CONFIG (inline JSON or a file path) is imported
# once into DuckDB when the store is empty, then ignored. Remove it after the
# first successful migration. Per-kind service env vars are not read.

# Extra allowed browser origins (comma-separated), e.g. a LAN/web deployment:
#   CORS_ALLOWED_ORIGINS=https://watchman.example.com
# watchman:// (desktop) and http://localhost / http://127.0.0.1 are always allowed.
CORS_ALLOWED_ORIGINS=

# Trust X-Forwarded-* headers (only enable behind a trusted reverse proxy).
TRUST_PROXY=false
