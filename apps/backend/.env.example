# Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$2b$10$your_password_hash_here
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Frontend URL (required in production, supports http/https)
FRONTEND_URL=http://localhost:5173

# Server Configuration
PORT=3001
NODE_ENV=development

# Enabled Services (comma-separated list, leave empty to enable all)
# Available services: bitcoin,adguard,tor,qbittorrent,synology,ipfs,roon,philips,homebridge,macmini,albyhub,beryl,telenet,raspi,nostrcheck
# Example: ENABLED_SERVICES=adguard,tor,bitcoin,synology
ENABLED_SERVICES=

# Multi-Instance Service Configuration
# For services that support multiple instances, use numbered prefixes:
# Example for multiple qBittorrent instances:
# QBITTORRENT_1_URL=http://192.168.0.10:8080
# QBITTORRENT_1_USERNAME=admin
# QBITTORRENT_1_PASSWORD=password1
# QBITTORRENT_2_URL=http://192.168.0.11:8080
# QBITTORRENT_2_USERNAME=admin
# QBITTORRENT_2_PASSWORD=password2
# Note: Legacy single-instance format (QBITTORRENT_URL) is still supported

# AdGuard Configuration
ADGUARD_MAIN_URL=http://192.168.0.1
ADGUARD_MAIN_AUTH=your-adguard-auth-token

# Bitcoin Configuration
BITCOIN_ONION_URL=your-onion-address.onion
BITCOIN_RPC_USER=your-bitcoin-rpc-user
BITCOIN_RPC_PASSWORD=your-bitcoin-rpc-password
BITCOIN_RPC_PORT=8332

# Tor Configuration
TOR_RELAY_NICKNAME=your-relay-nickname
TOR_RELAY_IP=your-ip-address

# qBittorrent Configuration
QBITTORRENT_URL=http://127.0.0.1:8069
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your-password

# Synology Configuration  
SYNOLOGY_HOST=192.168.0.100
SYNOLOGY_PORT=5000
SYNOLOGY_USERNAME=your-username
SYNOLOGY_PASSWORD=your-password

# IPFS Configuration
IPFS_API_URL=http://127.0.0.1:5001

# Roon Configuration
ROON_HOST=192.168.0.150
ROON_PORTS=9003,9330,9100

# Philips Hue Bridge Configuration
PHILIPS_BRIDGE_HOST=192.168.0.200

# Homebridge Configuration
HOMEBRIDGE_URL=http://192.168.0.210:8581
HOMEBRIDGE_AUTH_TOKEN=your-homebridge-token

# Mac Mini Configuration
MACMINI_HOST=127.0.0.1
MACMINI_SSH_USER=your-username
MACMINI_SSH_KEY_PATH=/path/to/your/ssh/key

# Alby Hub Configuration
ALBYHUB_URL=http://127.0.0.1:8080
ALBYHUB_TOKEN=your-albyhub-token

# Router Configuration (Beryl)
BERYL_HOST=192.168.0.1
BERYL_PORTS=80,443

# Router Configuration (Telenet)
TELENET_HOST=192.168.100.1
TELENET_PORTS=80

# Raspberry Pi Configuration
RASPI_HOST=192.168.0.230
RASPI_PORT=22

# Nostr Relay Configuration
NOSTRCHECK_RELAY_URL=wss://relay.yourdomain.com
NOSTRCHECK_WEB_URL=https://relay.yourdomain.com
NOSTRCHECK_ENABLED=true
