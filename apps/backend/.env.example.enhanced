# Watchman Backend Environment Configuration
# Copy to .env.local and configure for your environment

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_STRICT_DOMAIN=false

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authentication (REQUIRED)
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=$2a$10$YOUR_BCRYPT_HASH_HERE
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_for_security

# CSRF Protection
CSRF_COOKIE_NAME=csrfToken
CSRF_HEADER_NAME=x-csrf-token

# Rate Limiting (requests per window)
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CONTROL_MAX=10
RATE_LIMIT_HEALTH_MAX=200

# IP Access Control
ENABLE_IP_WHITELIST=false
IP_WHITELIST=127.0.0.1,::1

# =============================================================================
# PERFORMANCE & MONITORING
# =============================================================================

# Caching Configuration (TTL in seconds)
CACHE_HEALTH_TTL=10
CACHE_STATS_TTL=30
CACHE_LONGTERM_TTL=300

# Performance Monitoring
PERF_MAX_SAMPLES=100
PERF_MAX_ENDPOINTS=500
PERF_CLEANUP_INTERVAL=3600000
PERF_SLOW_THRESHOLD=1000
PERF_ERROR_THRESHOLD=10

# Logging Configuration
LOG_ENABLED=true
LOG_REQUESTS=true
LOG_LEVEL=info

# WebSocket Configuration
ENABLE_WEBSOCKETS=true
WEBSOCKET_HEARTBEAT_INTERVAL=30000
WEBSOCKET_MAX_CONNECTIONS_PER_IP=5

# =============================================================================
# SERVICE CONFIGURATIONS
# =============================================================================

# Enabled Services (comma-separated list)
ENABLED_SERVICES=bitcoin,adguard,tor

# Bitcoin Node Configuration
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=your_rpc_username
BITCOIN_RPC_PASSWORD=your_rpc_password
BITCOIN_TIMEOUT=120000
BITCOIN_CONNECT_TIMEOUT=30
BITCOIN_MAX_TIME=120
BITCOIN_ONION_URL=
BITCOIN_RPC_PORT=8332

# AdGuard Home Configuration
ADGUARD_MAIN_URL=http://localhost:3000
ADGUARD_MAIN_AUTH=your_base64_encoded_auth
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=your_password
ADGUARD_TIMEOUT=5000

# Tor Configuration
TOR_USE_PROXY=false
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
TOR_RELAY_NICKNAME=default-relay
TOR_ONIONOO_BASE_URL=https://onionoo.torproject.org

# qBittorrent Configuration
QBITTORRENT_MAIN_URL=http://localhost:8080
QBITTORRENT_MAIN_AUTH=your_base64_encoded_auth
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_password
QBITTORRENT_TIMEOUT=5000

# Synology NAS Configuration
SYNOLOGY_URL=https://your-nas.local:5001
SYNOLOGY_USERNAME=admin
SYNOLOGY_PASSWORD=your_password
SYNOLOGY_TIMEOUT=10000

# Roon Configuration
ROON_URL=http://localhost:9100
ROON_TIMEOUT=5000

# Philips Hue Configuration
PHILIPS_BRIDGE_IP=192.168.1.100
PHILIPS_BRIDGE_TOKEN=your_bridge_token
PHILIPS_BRIDGE_TIMEOUT=5000

# Alby Hub Configuration
ALBY_HUB_URL=http://localhost:8080
ALBY_HUB_TOKEN=your_api_token
ALBY_HUB_TIMEOUT=5000

# Mac Mini Configuration
MAC_MINI_SSH_HOST=192.168.1.10
MAC_MINI_SSH_USERNAME=admin
MAC_MINI_SSH_PRIVATE_KEY_PATH=/path/to/private/key
MAC_MINI_SSH_TIMEOUT=10000

# Router Configuration
ROUTER_URL=http://192.168.1.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=your_password
ROUTER_TIMEOUT=10000

# IPFS Configuration
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_TIMEOUT=10000

# Homebridge Configuration
HOMEBRIDGE_URL=http://localhost:8581
HOMEBRIDGE_USERNAME=admin
HOMEBRIDGE_PASSWORD=your_password
HOMEBRIDGE_TIMEOUT=5000

# Raspberry Pi Configuration
RPI_SSH_HOST=192.168.1.20
RPI_SSH_USERNAME=pi
RPI_SSH_PRIVATE_KEY_PATH=/path/to/private/key
RPI_SSH_TIMEOUT=10000

# =============================================================================
# SECURITY NOTES
# =============================================================================

# 1. Never commit this file to version control
# 2. Use strong, unique passwords for all services
# 3. Generate AUTH_PASSWORD_HASH using bcrypt with cost factor 10+
# 4. JWT_SECRET should be at least 32 characters of random data
# 5. Use HTTPS in production (set FRONTEND_URL to https://)
# 6. Enable IP whitelisting in production if possible
# 7. Regularly rotate passwords and tokens
# 8. Monitor logs for security events
# 9. Keep all services updated with latest security patches
# 10. Use strong network security (firewalls, VPN, etc.)

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================

# Before deploying to production:
# [ ] Set NODE_ENV=production
# [ ] Use HTTPS for FRONTEND_URL
# [ ] Configure strong JWT_SECRET
# [ ] Set up proper authentication
# [ ] Enable appropriate rate limiting
# [ ] Configure logging and monitoring
# [ ] Set up backup and recovery procedures
# [ ] Review and harden service configurations
# [ ] Enable security headers and CORS
# [ ] Set up SSL/TLS certificates
# [ ] Configure firewall and network security