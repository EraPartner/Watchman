# Backend Environment Variables (NOT exposed to frontend)
# Copy this file to .env.local and update with your actual values

# =============================================================================
# CRITICAL: NEVER commit .env.local files to version control!
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Authentication (REQUIRED)
# Generate secure values using: openssl rand -hex 32
AUTH_USERNAME=your_username
AUTH_PASSWORD_HASH=generate_with_bcrypt
JWT_SECRET=generate_secure_random_string_here

# CSRF Protection
CSRF_COOKIE_NAME=csrfToken

# Service Credentials (Update these with your actual service URLs and credentials)

# AdGuard Home Configuration
ADGUARD_MAIN_URL=http://your-adguard-host:port
ADGUARD_MAIN_AUTH=base64_encoded_username_password
VITE_ADGUARD_WEB_URL=http://your-adguard-host:port

# Bitcoin Node Configuration (if using)
BITCOIN_ONION_URL=your-bitcoin-onion-address.onion
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=your_rpc_user
BITCOIN_RPC_PASSWORD=your_secure_rpc_password

# qBittorrent Configuration (if using)
QBITTORRENT_URL=http://your-qbittorrent-host:port
QBITTORRENT_USERNAME=your_username
QBITTORRENT_PASSWORD=your_password
QBITTORRENT_TIMEOUT=5000

# Tor Configuration (if using)
TOR_RELAY_URL=https://onionoo.torproject.org
TOR_RELAY_NICKNAME=your_relay_nickname
TOR_RELAY_IP=your.relay.ip.address
TOR_METRICS_URL=https://metrics.torproject.org
TOR_DEFAULT_PORT=9001

# Tor Proxy Settings
TOR_USE_PROXY=false
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050

# Network Configuration
DEFAULT_IP=127.0.0.1

# Synology SNMP v3 Configuration (if using)
SYNOLOGY_HOST=your.synology.ip
SYNOLOGY_WEB_PORT=5000
SYNOLOGY_SNMP_PORT=161
SYNOLOGY_SNMP_USERNAME=your_snmp_user
SYNOLOGY_SNMP_AUTH_PROTOCOL=sha
SYNOLOGY_SNMP_AUTH_KEY=your_auth_key
SYNOLOGY_SNMP_PRIV_PROTOCOL=aes
SYNOLOGY_SNMP_PRIV_KEY=your_priv_key

# Roon (ROCK) Monitor Configuration (if using)
ROON_HOST=your.roon.host
ROON_PORTS=55002
ROON_DEFAULT_PORT=55002
ROON_TIMEOUT=5000
ROON_PING_COUNT=2
ROON_USE_PING=true
ROON_REFRESH_INTERVAL=30

# Philips Bridge Monitor (if using)
PHILIPS_BRIDGE_HOST=your.philips.bridge.ip

# Alby Hub Monitor (if using)
ALBYHUB_URL=http://your.albyhub.host:port
ALBYHUB_TOKEN=your_jwt_token_here

# Mac Mini Monitor (if using)
MACMINI_HOST=your.macmini.host
MACMINI_SSH_PORT=22
MACMINI_SSH_USER=your_ssh_user
MACMINI_SSH_KEY_PATH=/path/to/your/ssh/key

# Nostrcheck Relay Monitor (if using)
NOSTRCHECK_RELAY_URL=your.relay.host:port
NOSTRCHECK_WEB_URL=https://your.relay.domain

# Router Monitor Configuration (if using)
BERYL_HOST=192.168.1.1
BERYL_PORTS=80,443

TELENET_HOST=192.168.0.1
TELENET_PORTS=80,443

# IPFS Monitor (if using)
IPFS_HOST=your.ipfs.host
IPFS_PORT=5001
IPFS_WEB_UI_URL=http://your.ipfs.host:5001/webui
IPFS_TIMEOUT=5000
IPFS_API_URL=http://your.ipfs.host:5001
IPFS_FORCE_POST=true

# Homebridge Monitor (if using)
HOMEBRIDGE_URL=http://your.homebridge.host:port
HOMEBRIDGE_USERNAME=your_username
HOMEBRIDGE_PASSWORD=your_password