# Copy to .env.local and fill values as needed
# The backend uses dotenv and will load .env.local by default

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# AdGuard
ADGUARD_MAIN_URL=http://127.0.0.1:5213

# Tor
TOR_RELAY_NICKNAME=example-relay
TOR_RELAY_IP=127.0.0.1
DEFAULT_IP=127.0.0.1
TOR_DEFAULT_PORT=27801
TOR_METRICS_URL=https://metrics.torproject.org

# Bitcoin
BITCOIN_ONION_URL= (e.g. http://exampleonion.onion)
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=your_rpc_user
BITCOIN_RPC_AUTH=your_rpc_password_or_cookie

# Roon
ROON_HOST=
ROON_PORTS=
ROON_DEFAULT_PORT=

# qBittorrent
QBITTORRENT_URL=
QBITTORRENT_PORT=
QBITTORRENT_WEB_PORT=
QBITTORRENT_HOST=

# Synology
SYNOLOGY_HOST=
SYNOLOGY_WEB_PORT=5000
SYNOLOGY_HTTP_PORT=5000
SYNOLOGY_PORT=5000

# Notes:
# - Copy this file to backend/.env.local and set the values for your environment.
# - Keep sensitive credentials out of source control.
