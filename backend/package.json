{
  "name": "watchman-backend",
  "version": "1.0.0",
  "description": "Backend API for Watchman dashboard",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js --watch . --ext js,json",
    "dev:verbose": "nodemon server.js --watch . --ext js,json --verbose",
    "test": "echo \"Error: no test specified\" && exit 1",
    "logs": "node server.js | bunyan",
    "health-check": "curl -f http://localhost:3001/health || exit 1",
    "validate-env": "node -e \"import('./config.js').then(({validateEnvironment}) => validateEnvironment())\"",
    "lint": "eslint *.js services/*.js middleware/*.js",
    "security-audit": "npm audit --audit-level moderate",
    "security:check": "npm audit && npm run security:secrets",
    "security:fix": "npm audit fix",
    "security:secrets": "echo 'Checking for exposed secrets...' && ! grep -r -E '(password|secret|token|key).*=.*[A-Za-z0-9]{20,}' --exclude-dir=node_modules --exclude=package*.json . || (echo '⚠️  Possible secrets found!' && exit 1)",
    "precommit": "npm run validate-env && npm run lint",
    "docker:scan": "docker scan watchman-backend:latest || echo 'Install Docker Scan for vulnerability scanning'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "jsonwebtoken": "^9.0.0",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.18.3",
    "ssh2": "^1.13.0",
    "ping": "^0.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "tor",
    "adguard",
    "dashboard",
    "monitoring",
    "bitcoin",
    "synology",
    "homebridge"
  ],
  "author": "Your Name",
  "license": "MIT"
}
