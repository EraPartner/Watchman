{
  "name": "Watchman Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "overrideCommand": false,
  "containerUser": "root",
  "remoteUser": "dev",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--security-opt=no-new-privileges",
    "--memory=8g",
    "--memory-swap=8g",
    "--pids-limit=4096",
    "--tmpfs=/tmp:rw,nosuid,nodev,size=512m",
    "--tmpfs=/var/tmp:rw,noexec,nosuid,nodev,size=256m",
    "--publish=127.0.0.1:5173:5173",
    "--publish=127.0.0.1:3001:3001",
    "--publish=127.0.0.1:4173:4173"
  ],
  "mounts": [
    "source=watchman-claude-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=${localEnv:HOME}/.claude-watchman-stage,target=/home/dev/.claude-stage,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig-host,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/github.pub,target=/home/dev/.ssh/host-signing.pub,type=bind,readonly",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],
  "containerEnv": {
    "DEVCONTAINER": "true",
    "NODE_ENV": "development",
    "BACKEND_V2_HOST": "0.0.0.0",
    "BACKEND_V2_PORT": "3001",
    "VITE_FRONTEND_PORT": "5173",
    "VITE_PREVIEW_PORT": "4173",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "HTTP_PROXY": "http://127.0.0.1:3128",
    "HTTPS_PROXY": "http://127.0.0.1:3128",
    "http_proxy": "http://127.0.0.1:3128",
    "https_proxy": "http://127.0.0.1:3128",
    "NO_PROXY": "localhost,127.0.0.1,::1",
    "no_proxy": "localhost,127.0.0.1,::1"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
