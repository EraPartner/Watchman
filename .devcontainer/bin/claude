#!/usr/bin/env bash
# Wrapper: route `claude` invocations into the Watchman devcontainer.
#
# This script lives at .devcontainer/bin/claude. The walk-up logic finds the
# project root by looking for .devcontainer/devcontainer.json so the wrapper
# works whether you call it directly (./devcontainer/bin/claude) or via a
# PATH/shell-function indirection from anywhere inside the repo.
#
# Responsibilities (all on the HOST, before entering the container):
#   1. Stage a SANITIZED copy of ~/.claude into ~/.claude-watchman-stage so the
#      container never sees host secrets (.credentials.json) or auto-runs host
#      hooks/MCP servers/plugins. That staging dir is the only thing bind-
#      mounted (read-only) into the container.
#   2. `devcontainer up` (idempotent; fast when warm).
#   3. Forward the Claude OAuth token and the gh token from the macOS Keychain
#      as env vars at exec time — neither is ever written to a file on disk.

set -euo pipefail

# Walk up from PWD until we find .devcontainer/devcontainer.json.
find_project_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/.devcontainer/devcontainer.json" ]]; then
      echo "$d"; return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

if [[ -n "${WATCHMAN_PROJECT_ROOT:-}" && -f "${WATCHMAN_PROJECT_ROOT}/.devcontainer/devcontainer.json" ]]; then
  PROJECT_ROOT="$WATCHMAN_PROJECT_ROOT"
else
  PROJECT_ROOT="$(find_project_root || true)"
fi

if [[ -z "$PROJECT_ROOT" ]]; then
  echo "claude (watchman-wrapper): no .devcontainer/devcontainer.json above $PWD." >&2
  echo "Falling back to host claude binary." >&2
  exec command claude "$@"
fi

if ! command -v devcontainer >/dev/null 2>&1; then
  echo "claude (watchman-wrapper): @devcontainers/cli not installed." >&2
  echo "  npm install -g @devcontainers/cli" >&2
  exit 1
fi

# --- 1) Stage a sanitized ~/.claude for the read-only bind mount -------------
# The container's devcontainer.json binds ~/.claude-watchman-stage (NOT the raw
# ~/.claude), so secrets and active code-exec config never enter its view.
stage_claude_config() {
  local src dst item
  src="$(cd "$HOME/.claude" 2>/dev/null && pwd -P || true)"   # resolve symlink
  dst="$HOME/.claude-watchman-stage"
  # Rebuild the stage from scratch each time so a previously-staged file that's
  # no longer allowlisted (or a removed host file) doesn't linger.
  rm -rf "$dst/dot-claude"; mkdir -p "$dst/dot-claude"
  if [[ -n "$src" && -d "$src" ]]; then
    # ALLOWLIST (not blocklist): copy only known-safe, non-auto-executing
    # config. Everything else is excluded by default — including code-exec
    # surfaces that a "copy all, delete a few" approach would leak:
    # status-line.sh / statusLine (runs every render), scheduled-tasks/, tasks/,
    # jobs/, daemon/, plugins/ (code), and host secrets/session state.
    for item in settings.json keybindings.json CLAUDE.md agents rules commands; do
      [[ -e "$src/$item" ]] && cp -a "$src/$item" "$dst/dot-claude/" 2>/dev/null || true
    done
    # Defense-in-depth: strip any exec-capable keys from staged settings.json.
    if [[ -f "$dst/dot-claude/settings.json" ]] && command -v jq >/dev/null 2>&1; then
      tmp="$(mktemp)"
      if jq 'del(.hooks) | del(.enabledPlugins) | del(.statusLine)' "$dst/dot-claude/settings.json" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$dst/dot-claude/settings.json"
      else rm -f "$tmp"; fi
    fi
    find "$dst/dot-claude" -name '.DS_Store' -delete 2>/dev/null || true
  fi
  # Sanitized ~/.claude.json seed (strip mcpServers/hooks/enabledPlugins).
  if [[ -f "$HOME/.claude.json" ]] && command -v jq >/dev/null 2>&1; then
    jq 'del(.mcpServers) | del(.hooks) | del(.enabledPlugins)' "$HOME/.claude.json" \
      > "$dst/claude.json" 2>/dev/null || true
  fi
}
stage_claude_config

# --- 2) Ensure the container is up (idempotent) ------------------------------
devcontainer up --workspace-folder "$PROJECT_ROOT" >/dev/null

# --- 3) Forward credentials from the macOS Keychain at exec time -------------
EXEC_ARGS=()

kc() { security find-generic-password -s "$1" -w 2>/dev/null || true; }

if command -v security >/dev/null 2>&1; then
  tok="$(kc 'watchman-claude-code-token')"
  [[ -n "$tok" ]] && EXEC_ARGS+=(--remote-env "CLAUDE_CODE_OAUTH_TOKEN=$tok")
  gh_tok="$(kc 'watchman-gh-token')"
  [[ -n "$gh_tok" ]] && EXEC_ARGS+=(--remote-env "GH_TOKEN=$gh_tok" --remote-env "GITHUB_TOKEN=$gh_tok")
fi

# Fallback: plain env vars from the host shell (if Keychain entries absent).
# ${EXEC_ARGS[@]+...} guards against "unbound variable" on an empty array under
# `set -u` (macOS default bash 3.2) when no token was found.
have_claude=0
for a in ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"}; do [[ "$a" == CLAUDE_CODE_OAUTH_TOKEN=* ]] && have_claude=1; done
if (( ! have_claude )); then
  for var in CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; do
    val="${!var:-}"
    [[ -n "$val" ]] && EXEC_ARGS+=(--remote-env "${var}=${val}")
  done
fi

# Forward all args. claude is interactive — stdin/tty flow through devcontainer exec.
exec devcontainer exec --workspace-folder "$PROJECT_ROOT" ${EXEC_ARGS[@]+"${EXEC_ARGS[@]}"} claude "$@"
