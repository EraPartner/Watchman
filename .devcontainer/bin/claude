#!/usr/bin/env bash
# Compose launcher: route `claude` into the Watchman sandbox WITHOUT devcontainers.
# The devcontainer-free equivalent of bin/claude — uses `docker compose` +
# .devcontainer/compose.yaml instead of `devcontainer up`/`exec`. bin/claude
# (devcontainer) stays as the fallback during the migration.
#
# Responsibilities, all on the HOST before entering the container:
#   1. Stage a SANITIZED ~/.claude into ~/.claude-sandbox/stage/watchman (no secrets).
#   2. docker compose up -d --build (idempotent; fast when warm).
#   3. Replay lifecycle as `dev`: post-create once (sentinel), post-start always.
#   4. Forward the Claude OAuth token from the macOS Keychain at exec time.
#   5. Auto config-sync: push container changes back to the host on session exit
#      (pull-on-launch is done by post-start.sh). Disable with WATCHMAN_AUTOSYNC=0.
set -euo pipefail

find_project_root() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/.devcontainer/compose.yaml" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

if [[ -n "${WATCHMAN_PROJECT_ROOT:-}" && -f "${WATCHMAN_PROJECT_ROOT}/.devcontainer/compose.yaml" ]]; then
  PROJECT_ROOT="$WATCHMAN_PROJECT_ROOT"
else
  PROJECT_ROOT="$(find_project_root || true)"
fi
[[ -z "$PROJECT_ROOT" ]] && { echo "claude (watchman-compose): no .devcontainer/compose.yaml above $PWD." >&2; exit 1; }

command -v docker >/dev/null 2>&1 || { echo "claude (watchman-compose): docker not installed." >&2; exit 1; }
docker compose version >/dev/null 2>&1 || { echo "claude (watchman-compose): docker compose v2 required." >&2; exit 1; }

COMPOSE=(docker compose -f "$PROJECT_ROOT/.devcontainer/compose.yaml")
SVC=app

# --- 1) Stage a sanitized ~/.claude for the read-only bind mount -------------
# Shared host-side helpers (vendored by devcontainer-egress/sync.sh).
LIB="$PROJECT_ROOT/.devcontainer/launcher-common.sh"
[[ -f "$LIB" ]] || { echo "claude (watchman-compose): missing $LIB (run devcontainer-egress/sync.sh)." >&2; exit 1; }
# shellcheck source=/dev/null
source "$LIB"
sandbox_stage_claude_config watchman

# --- 2) Build + start (idempotent) -------------------------------------------
"${COMPOSE[@]}" up -d --build >/dev/null
CID="$("${COMPOSE[@]}" ps -q "$SVC" 2>/dev/null | head -1 || true)"

# --- 3) Replay lifecycle as dev (mirrors postCreateCommand/postStartCommand) --
# post-create runs once per container (sentinel in the container's writable
# layer, gone on `compose down`/rebuild — same cadence as devcontainer create).
# post-start runs every launch and exits non-zero if egress isn't verified, so a
# failure here aborts before we hand a session a possibly-open network.
"${COMPOSE[@]}" exec -u dev -T "$SVC" bash -lc '
  set -e
  cd /workspaces/Watchman
  if [[ ! -f /home/dev/.postcreate-done ]]; then
    bash .devcontainer/post-create.sh && touch /home/dev/.postcreate-done
  fi
  bash .devcontainer/post-start.sh'

# --- 4) Forward the Claude OAuth token from the macOS Keychain at exec time ---
# No git push credential is ever forwarded (commits happen on the HOST).
EXEC_ENV=()
sandbox_forward_llm_creds watchman-claude-code-token

# --- 5) Launch-integrity gate: refuse to start if a pinned binary drifted ------
# Tolerant: warns (doesn't abort) until the image is rebuilt with the pins baked,
# so this lands without breaking a running container; once rebuilt it enforces.
if "${COMPOSE[@]}" exec -u dev -T "$SVC" bash -lc 'command -v watchman-verify-pins >/dev/null 2>&1'; then
  # Run in a CLEAN shell: safe-chain (BASH_ENV) wraps npm/pip as shell functions,
  # which shadow the real binary paths and would false-trip the gate.
  if ! "${COMPOSE[@]}" exec -u dev -T -e BASH_ENV= "$SVC" watchman-verify-pins --quiet; then
    echo "claude (watchman-compose): ABORT — binary fingerprint drift (see above)." >&2
    echo "  If you intentionally upgraded a tool, rebuild to re-pin: ${COMPOSE[*]} build --no-cache $SVC" >&2
    exit 1
  fi
else
  echo "claude (watchman-compose): verify-pins not baked yet — rebuild to enable launch-integrity checks: ${COMPOSE[*]} build $SVC" >&2
fi

# --- 6) Auto config-sync: push container changes back on exit -----------------
# Installed AFTER the verify-pins gate on purpose: an aborted launch (pin drift,
# exit 1 above) must NOT fire the EXIT trap and push a never-used container
# ~/.claude back to the host.
sandbox_install_autosync_trap watchman "$CID" "${WATCHMAN_AUTOSYNC:-1}"

# Interactive claude. NOT `exec` — bash must outlive the session to run the EXIT
# trap that syncs config/memory back to the host.
set +e
"${COMPOSE[@]}" exec -u dev ${EXEC_ENV[@]+"${EXEC_ENV[@]}"} "$SVC" claude "$@"
_rc=$?
set -e
exit "$_rc"
