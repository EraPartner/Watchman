# Multi-stage build for production optimization
FROM node:18-alpine AS builder

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S watchman -u 1001

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY vite.config.ts ./
COPY tailwind.config.ts ./
COPY postcss.config.js ./

# Install dependencies (production only)
RUN npm ci --only=production --no-audit --no-fund

# Copy source code
COPY src/ ./src/
COPY public/ ./public/
COPY index.html ./

# Build application
ENV NODE_ENV=production
RUN npm run build

# Production stage - Simple static file server
FROM node:18-alpine AS production

# Security: Install security updates
RUN apk upgrade --no-cache && \
    apk add --no-cache dumb-init curl

# Install serve for static file serving
RUN npm install -g serve@14

# Security: Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S watchman -u 1001 -G nodejs

# Create app directory
WORKDIR /app

# Copy built application from builder stage
COPY --from=builder --chown=watchman:nodejs /app/dist ./dist

# Security: Set proper file permissions
RUN chown -R watchman:nodejs /app && \
    find /app -type f -exec chmod 644 {} \; && \
    find /app -type d -exec chmod 755 {} \;

# Remove unnecessary files and caches
RUN rm -rf /var/cache/apk/* /tmp/* /var/tmp/* /root/.npm

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Switch to non-root user
USER watchman

# Expose port (serve uses 3000 by default)
EXPOSE 3000

# Use dumb-init for proper signal handling
ENTRYPOINT ["/usr/bin/dumb-init", "--"]

# Start static file server
CMD ["serve", "-s", "dist", "-l", "3000"]