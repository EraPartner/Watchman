<?xml version="1.0" encoding="UTF-8"?>
<!--
Template LaunchAgent plist for running autossh on the origin Mac to create persistent SSH reverse tunnels
Save as: ~/Library/LaunchAgents/com.YOUR_USER.autossh.plist
Edit the ProgramArguments user@host and autossh path as needed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.YOUR_USER.autossh</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Path to autossh binary (use `which autossh`) -->
    <string>/usr/local/bin/autossh</string>
    <string>-M</string>
    <string>0</string>
    <string>-N</string>
    <string>-o</string>
    <string>ServerAliveInterval=60</string>
    <string>-o</string>
    <string>ServerAliveCountMax=3</string>
    <!-- Add remote forwards here: remote_port:local_host:local_port -->
    <string>-R</string>
    <string>127.0.0.1:3001:127.0.0.1:3001</string>
    <string>-R</string>
    <string>127.0.0.1:5000:127.0.0.1:5000</string>
    <!-- Replace with the ssh user and host for your Caddy machine -->
    <string>user@caddy-host.example.com</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/autossh.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/autossh.err.log</string>
</dict>
</plist>
