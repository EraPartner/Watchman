# Caddy Configuration for Watchman Dashboard
# This configuration assumes Caddy is running on a separate host on the LAN

# Replace with your actual domain/IP and backend host IP
your-domain.com {
    # Security headers
    header {
        # HSTS
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        # XSS Protection
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        
        # CSP for enhanced security
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' wss: ws:; font-src 'self'"
        
        # Remove server identification
        -Server
    }

    # Rate limiting (requires caddy-rate-limit plugin)
    rate_limit {
        zone dynamic_api {
            key {remote_host}
            events 100
            window 1m
        }
        zone dynamic_auth {
            key {remote_host}
            events 10
            window 1m
        }
    }

    # Enable compression
    encode gzip

    # API endpoints with rate limiting
    @api path /api/*
    rate_limit @api dynamic_api
    reverse_proxy @api http://BACKEND_HOST_IP:3001 {
        # Health check
        health_uri /health
        health_interval 30s
        health_timeout 5s
        
        # Headers for backend
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        
        # Remove backend server headers
        header_down -X-Powered-By
    }

    # Auth endpoints with stricter rate limiting
    @auth path /api/auth/*
    rate_limit @auth dynamic_auth
    reverse_proxy @auth http://BACKEND_HOST_IP:3001 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # WebSocket support
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket http://BACKEND_HOST_IP:3001

    # Static file serving with caching
    @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    header @static Cache-Control "public, max-age=31536000, immutable"
    
    # Serve frontend static files
    root * /var/www/watchman
    try_files {path} /index.html
    file_server

    # Logging
    log {
        output file /var/log/caddy/watchman-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# Redirect HTTP to HTTPS
http://your-domain.com {
    redir https://{host}{uri} permanent
}