#!/usr/bin/env sh
#
# Watchman commit-msg -- enforce Conventional Commits via commitlint
# (config: commitlint.config.mjs, @commitlint/config-conventional).
#
# Wiring:   git config core.hooksPath .githooks   (done by scripts/setup-git-hooks.mjs)
# Bypass:   git commit --no-verify        or       SKIP_HOOKS=1 git commit ...
#
# Output is ASCII-only on purpose (see the note in pre-commit).

set -u

if [ "${SKIP_HOOKS:-}" = "1" ]; then
  echo "[commit-msg] SKIP_HOOKS=1 -- skipping."
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0
CL="$REPO_ROOT/node_modules/.bin/commitlint"

# Skip (don't fail) if deps aren't installed yet -- mirrors how pre-commit treats
# a missing gitleaks, so a fresh clone can still commit before 'npm run deps:ci'.
if [ ! -x "$CL" ]; then
  echo "[commit-msg] commitlint not installed (run 'npm run deps:ci') -- skipping commit-message lint."
  exit 0
fi

"$CL" --edit "$1"
